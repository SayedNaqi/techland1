# ---- Postgres ----
# Docker compose maps host 5433 -> container 5432 (host 5432 is often taken by a local Postgres service).
# From your Windows host use :5433; from inside docker network the backend uses postgres:5432 (see docker-compose.yml).
DATABASE_URL=postgres://techland:techland_dev_password@localhost:5433/techland
# e.g. docker compose internal: postgres://techland:techland_dev_password@postgres:5432/techland

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ADMIN_TTL=12h
JWT_USER_TTL=7d

# ---- Bootstrap admin (only used when admins table is empty) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Server ----
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
